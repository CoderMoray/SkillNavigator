#!/usr/bin/env bash
# ==============================================================================
# SkillNavigator CLI (skillnav) 一键安装与配置脚本
# 部署后访问：（部署方未配置对外 Web 地址——请向平台维护者索取）/install（勿直接改 apps/web/public/install）
# 规范与特性：
# 1. 自动判定环境并安装 CLI（PyPI 优先，10s 超时后回退阿里云镜像；兼容 pipx、PEP 668）
# 2. 安装后真实运行 CLI 自检；发现依赖缺失（No module named …）自动补装或强制重装
# 3. 自动探测安装路径并修复 PATH（自动写入 ~/.zshrc 或 ~/.bash_profile）
# 4. 自动配置与测试平台 Registry（支持多 profile / 强制覆盖）
# 5. 支持传参 --api-key 自动完成登录与 whoami 身份验证，或在终端交互输入
# ==============================================================================

set -e

REGISTRY_URL="（部署方未配置 Registry API 地址——请向平台维护者索取）"
WEB_URL="（部署方未配置对外 Web 地址——请向平台维护者索取）"
PIP_INDEX_PYPI="https://pypi.org/simple"
PIP_INDEX_ALIYUN="https://mirrors.aliyun.com/pypi/simple/"
PIP_INSTALL_TIMEOUT=10
API_KEY=""
# 实际成功使用的 PyPI 索引（第 1 步可能已回退到镜像），供安装后的依赖自愈复用
USED_INDEX=""
# CLI 可用性自检：成功时保存 `skillnav --version` 输出，失败时保存原始报错
SKILLNAV_VERSION_TEXT=""
SKILLNAV_CHECK_ERROR=""
# 流程状态：供结尾汇总，避免失败时仍打印"全部就绪"（1=通过）
REGISTRY_OK=1
LOGIN_OK=1

# ------------------------------------------------------------------------------
# 0. 解析输入参数（支持 --api-key sk_...）
# ------------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --api-key)
            API_KEY="$2"
            shift 2
            ;;
        --registry)
            REGISTRY_URL="$2"
            shift 2
            ;;
        -h|--help)
            echo "用法: curl -fsSL ${WEB_URL}/install | bash -s -- [选项]"
            echo ""
            echo "选项:"
            echo "  --api-key <KEY>     可选，自动完成登录验证（在 Web 端「设置 → API 密钥」获取）"
            echo "  --registry <URL>    可选，自定义 Registry API 地址（默认: $REGISTRY_URL）"
            echo "  -h, --help          显示帮助信息"
            exit 0
            ;;
        *)
            echo "⚠️ 未知参数: $1"
            shift
            ;;
    esac
done

# 写入 profile registry：优先 --registry（Python 3.12+ / 较新 Typer）；
# 部分 macOS Python 3.9 环境子命令 --registry 与全局选项冲突，回退为位置参数。
skillnav_config_add_profile() {
    local profile_name="$1"
    local registry_url="$2"

    if skillnav config add "$profile_name" --registry "$registry_url" 2>/dev/null; then
        return 0
    fi
    if skillnav config add "$profile_name" "$registry_url" 2>/dev/null; then
        echo "  ℹ️  已通过位置参数写入 Registry（当前 Python/Typer 环境）。"
        return 0
    fi

    # `config add` refuses a name that already exists (by design) and tells the
    # caller to reuse it with `config use`. Re-running this installer is normal,
    # so activate the existing profile instead of failing — otherwise `set -e`
    # aborts the script right here on a machine that is already configured.
    if skillnav config use "$profile_name" 2>/dev/null; then
        echo "  ℹ️  profile '$profile_name' 已存在，已切换为当前 profile。"
        echo "     如需改指向其它 Registry，请先执行 skillnav config remove $profile_name 再重跑本脚本。" >&2
        return 0
    fi

    echo "❌ 无法配置 Registry profile '$profile_name'。" >&2
    echo "   请手动尝试：" >&2
    echo "     skillnav config add $profile_name --registry \"$registry_url\"" >&2
    echo "     或 skillnav config add $profile_name \"$registry_url\"" >&2
    return 1
}

# pip / pipx 安装 skillnav：指定 index 与超时（秒）。
skillnav_install_via_pip() {
    local index_url="$1"
    python3 -m pip install --user -i "$index_url" --timeout "$PIP_INSTALL_TIMEOUT" \
        --break-system-packages skillnav 2>/dev/null || \
    python3 -m pip install --user -i "$index_url" --timeout "$PIP_INSTALL_TIMEOUT" skillnav
}

skillnav_install_via_pipx() {
    local index_url="$1"
    pipx install skillnav --force \
        --pip-args="-i ${index_url} --timeout ${PIP_INSTALL_TIMEOUT}"
}

try_install_skillnav() {
    local index_url="$1"
    local label="$2"
    echo "  -> 正在从 ${label} 安装 (超时 ${PIP_INSTALL_TIMEOUT}s)..."
    if command -v pipx &>/dev/null; then
        echo "  -> 使用 pipx 隔离环境..."
        skillnav_install_via_pipx "$index_url"
    elif command -v python3 &>/dev/null; then
        echo "  -> 使用 python3 -m pip --user..."
        skillnav_install_via_pip "$index_url"
    else
        echo "❌ 错误: 未检测到 Python3 或 pipx，请先安装 Python 环境。" >&2
        exit 1
    fi
}

# ------------------------------------------------------------------------------
# 0.1 安装完整性自检与依赖自愈
#   pip / pipx 成功只代表"包本身装上了"，不代表依赖完整：网络中断、镜像缺包、
#   本机 pip 被配置为跳过依赖（--no-deps / PIP_NO_DEPS）等，都会留下
#   "入口能执行、import 时报 No module named" 的破损环境。
#   因此安装后必须真正运行一次 CLI，并按报错补齐缺失依赖。
# ------------------------------------------------------------------------------

# skillnav 入口脚本 shebang 指向的解释器（即实际安装它的 Python 环境）
skillnav_python() {
    local bin
    bin="$(command -v skillnav 2>/dev/null)" || return 1
    [ -n "$bin" ] || return 1
    sed -n '1s/^#![[:space:]]*//p' "$bin" | awk '{ if ($1 ~ /(^|\/)env$/) print $2; else print $1 }'
}

# 从 Python 报错文本中提取缺失的顶层模块名（`No module named 'click'` -> click）
skillnav_missing_modules() {
    printf '%s' "$1" \
        | sed -n "s/.*No module named '\([A-Za-z0-9_.]*\)'.*/\1/p" \
        | cut -d. -f1 | sort -u | tr '\n' ' ' | sed 's/ $//'
}

# 真实可用性自检：能正常执行 --version 才算安装成功（退出码 + 输出都检查）
skillnav_self_check() {
    local out="" rc=0
    out="$(skillnav --version 2>&1)" || rc=$?
    if [ "$rc" -eq 0 ] && [ -n "$out" ]; then
        SKILLNAV_VERSION_TEXT="$out"
        return 0
    fi
    SKILLNAV_CHECK_ERROR="$out"
    return 1
}

# 补装缺失依赖：优先 pipx inject（仍由 pipx 管理），否则用入口解释器的 pip
skillnav_repair_dependencies() {
    local modules="$1"
    local index_url="$2"
    [ -n "$modules" ] || return 1

    echo "  -> 尝试补装缺失依赖: ${modules% }"

    case "$(command -v skillnav)" in
        */pipx/venvs/*)
            if command -v pipx &>/dev/null; then
                # --force：包已存在但文件不完整时也重装，避免被"already injected, not
                # modifying"直接跳过（pipx 这种情况下会照常返回成功）
                # shellcheck disable=SC2086  # 模块名需按空格展开为多个参数
                if pipx inject --force \
                    --pip-args="-i ${index_url} --timeout ${PIP_INSTALL_TIMEOUT}" \
                    skillnav $modules; then
                    return 0
                fi
            fi
            ;;
    esac

    local py_bin
    py_bin="$(skillnav_python)" || return 1
    case "$py_bin" in
        /*) ;;
        *) py_bin="$(command -v "$py_bin" 2>/dev/null)" || return 1 ;;
    esac
    # 只接受 Python 解释器（shebang 为 `env 其它命令` 时直接放弃，走重装兜底）
    case "$py_bin" in
        *python*) ;;
        *) return 1 ;;
    esac
    [ -x "$py_bin" ] || return 1

    # shellcheck disable=SC2086
    "$py_bin" -m pip install -i "$index_url" --timeout "$PIP_INSTALL_TIMEOUT" $modules
}

# 自检失败后的自愈：先补缺失依赖，再退化为强制重装；仍失败则明确报错退出
ensure_skillnav_usable() {
    local index_url="${USED_INDEX:-$PIP_INDEX_PYPI}"
    local modules=""
    local attempt=0

    # 自己先确认一次：避免沿用调用方过期的报错信息去补装错误的模块
    if skillnav_self_check; then
        return 0
    fi

    echo "  ⚠️ 检测到 skillnav 已安装但无法运行，原始报错如下："
    printf '%s\n' "$SKILLNAV_CHECK_ERROR" | sed 's/^/      /'

    # 缺失模块可能不止一个（pip 中断时会留下"部分依赖已装"的破损环境），
    # 每轮从最新报错里取一个模块补齐，最多 3 轮。
    while [ "$attempt" -lt 3 ]; do
        modules="$(skillnav_missing_modules "$SKILLNAV_CHECK_ERROR")"
        [ -n "$modules" ] || break
        attempt=$((attempt + 1))
        if ! skillnav_repair_dependencies "$modules" "$index_url"; then
            break
        fi
        if skillnav_self_check; then
            echo "  ✅ 缺失依赖已自动补装（${modules}），CLI 恢复正常。"
            return 0
        fi
    done

    echo "  -> 依赖补装未生效，尝试强制重装 skillnav..."
    if try_install_skillnav "$index_url" "已配置的 PyPI 索引" && skillnav_self_check; then
        echo "  ✅ 重装后 CLI 恢复正常。"
        return 0
    fi

    echo "❌ 安装不完整：skillnav 安装后仍无法运行。" >&2
    echo "   请手动尝试：" >&2
    echo "     pipx install --force skillnav" >&2
    echo "     pipx inject skillnav ${modules:-typer click}" >&2
    echo "   诊断当前环境：pipx list && pipx runpip skillnav list" >&2
    exit 1
}

echo "=================================================="
echo "🚀 欢迎使用 SkillNavigator 一键安装引导"
echo "=================================================="
echo ""

# ------------------------------------------------------------------------------
# 1. 自动判定并安装 CLI
# ------------------------------------------------------------------------------
echo "📦 [1/4] 检查环境并安装 skillnav CLI..."

if try_install_skillnav "$PIP_INDEX_PYPI" "PyPI"; then
    USED_INDEX="$PIP_INDEX_PYPI"
elif try_install_skillnav "$PIP_INDEX_ALIYUN" "阿里云 PyPI 镜像"; then
    USED_INDEX="$PIP_INDEX_ALIYUN"
    echo "  ℹ️  PyPI 不可用或超时，已改用阿里云镜像完成安装。"
else
    echo "❌ 错误: 连接超时，PyPI 与阿里云镜像均无法在 ${PIP_INSTALL_TIMEOUT}s 内完成安装。" >&2
    echo "   请检查网络、代理或 VPN，或手动安装: pip install skillnav -i ${PIP_INDEX_ALIYUN}" >&2
    exit 1
fi

echo "  -> skillnav 安装步骤完成。"
echo ""

# ------------------------------------------------------------------------------
# 2. 自动探测并修复 PATH
# ------------------------------------------------------------------------------
echo "🔍 [2/4] 探测可执行文件路径与配置 PATH..."

PY_VER=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')" 2>/dev/null || echo "3.9")

# 候选目录列表（覆盖 macOS 与 Linux 常见 user bin 目录）
POSSIBLE_PATHS=(
    "$HOME/Library/Python/${PY_VER}/bin"
    "$HOME/Library/Python/3.9/bin"
    "$HOME/Library/Python/3.10/bin"
    "$HOME/Library/Python/3.11/bin"
    "$HOME/Library/Python/3.12/bin"
    "$HOME/Library/Python/3.13/bin"
    "$HOME/Library/Python/3.14/bin"
    "$HOME/.local/bin"
    "/opt/homebrew/bin"
    "/usr/local/bin"
)

FOUND_BIN=""

# 如果当前已经在 PATH 里直接能找到
if command -v skillnav &>/dev/null; then
    FOUND_BIN="$(dirname "$(command -v skillnav)")"
else
    for p in "${POSSIBLE_PATHS[@]}"; do
        if [ -f "$p/skillnav" ]; then
            FOUND_BIN="$p"
            break
        fi
    done
fi

if [ -n "$FOUND_BIN" ]; then
    export PATH="$FOUND_BIN:$PATH"

    # 判定用户使用的 Shell 配置文件
    SHELL_NAME="$(basename "${SHELL:-zsh}")"
    TARGET_RC="$HOME/.zshrc"
    if [ "$SHELL_NAME" = "bash" ]; then
        if [ -f "$HOME/.bash_profile" ]; then
            TARGET_RC="$HOME/.bash_profile"
        else
            TARGET_RC="$HOME/.bashrc"
        fi
    fi

    # 检查是否已包含在配置文件中
    if ! grep -q "$FOUND_BIN" "$TARGET_RC" 2>/dev/null; then
        echo "" >> "$TARGET_RC"
        echo "# Added by SkillNavigator installer" >> "$TARGET_RC"
        echo "export PATH=\"$FOUND_BIN:\$PATH\"" >> "$TARGET_RC"
        echo "  ✅ 已将 $FOUND_BIN 自动追加写入到 $TARGET_RC"
    else
        echo "  ℹ️  $TARGET_RC 中已存在该路径配置"
    fi
else
    echo "⚠️ 未在预期目录找到 skillnav，后续命令可能需要手动指定绝对路径。"
fi

# 二次确认 CLI 真正可用（含依赖完整性）
if ! command -v skillnav &>/dev/null; then
    echo "❌ 无法调用 skillnav，请检查安装结果。"
    exit 1
fi

# 自检 + 不可用时自动补装/重装（函数内部先自检一次，可用时静默返回）
ensure_skillnav_usable

echo "  ✅ CLI 验证成功！当前版本: $(printf '%s' "$SKILLNAV_VERSION_TEXT" | tr -d '\n')"
echo ""

# ------------------------------------------------------------------------------
# 3. 自动配置 Registry
# ------------------------------------------------------------------------------
echo "⚙️  [3/4] 配置 Registry 地址..."
echo "  -> Registry API: $REGISTRY_URL"

# 添加或更新 default profile（profile 已存在时函数内部会退化为 config use）
# `|| true`：脚本带 set -e，配置失败不应中断安装——连通性由下面的 config test 判定
skillnav_config_add_profile default "$REGISTRY_URL" || true
skillnav config use default 2>/dev/null || true

# 测试连通性
echo "  -> 正在测试与平台的连通性..."
if skillnav config test; then
    echo "  ✅ Registry 连通正常。"
else
    REGISTRY_OK=0
    echo "  ⚠️ Registry 连通性测试未通过，请检查网络（或是否需要开启内网代理/VPN）。"
fi
echo ""

# ------------------------------------------------------------------------------
# 4. 自动完成登录与验证
# ------------------------------------------------------------------------------
echo "🔑 [4/4] 账号登录与身份验证..."

# 如果没有通过参数传递 API Key，则进行友好交互引导
if [ -z "$API_KEY" ]; then
    echo "  尚未提供 API 密钥。"
    echo "  请访问: $WEB_URL"
    echo "  进入「设置 → API 密钥」生成您的 Token (格式如: sk_...)"
    echo ""
    if [ -t 0 ]; then
        read -r -p "  请输入您的 API 密钥 (留空跳过): " INPUT_KEY
        API_KEY="$INPUT_KEY"
    fi
fi

if [ -n "$API_KEY" ]; then
    echo "  -> 正在登录..."
    LOGIN_RC=0
    if skillnav login --api-key "$API_KEY"; then
        echo "  ✅ 登录成功！当前身份信息："
        skillnav whoami || true
    else
        LOGIN_RC=$?
        LOGIN_OK=0
        case "$LOGIN_RC" in
            2)
                echo "  ❌ 登录失败：API 密钥无效、已过期或已停用（CLI 退出码 2）。" >&2
                echo "     请到 Web 端「设置 → API 密钥」确认密钥状态后重试。" >&2
                ;;
            4)
                echo "  ❌ 登录失败：无法连接 Registry（CLI 退出码 4）：$REGISTRY_URL" >&2
                echo "     请检查网络、代理或 VPN；连通后可手动重试：skillnav login --api-key <KEY>" >&2
                ;;
            *)
                echo "  ❌ 登录失败（CLI 退出码 $LOGIN_RC）：这通常不是密钥问题，而是 CLI 或本地环境异常。" >&2
                echo "     请先执行 skillnav --version 排查；诊断：pipx runpip skillnav list" >&2
                ;;
        esac
    fi
else
    echo "  ℹ️  已跳过自动登录。后续可随时运行以下命令登录："
    echo "     skillnav login --api-key <您的Key>"
fi

echo ""
echo "=================================================="
if [ "$REGISTRY_OK" -eq 1 ] && [ "$LOGIN_OK" -eq 1 ]; then
    echo "🎉 SkillNavigator 安装与配置流程已全部就绪！"
else
    echo "⚠️  SkillNavigator 安装已完成，但部分步骤未通过："
    if [ "$REGISTRY_OK" -eq 0 ]; then
        echo "   • Registry 连通性测试（见上方提示，多为网络/代理问题）"
    fi
    if [ "$LOGIN_OK" -eq 0 ]; then
        echo "   • 账号登录（原因见上方；修复后重跑本脚本是安全的）"
    fi
fi
echo "=================================================="
echo "👉 请在新打开的终端窗口中使用 skillnav"
echo "   或者在当前窗口运行: source ~/.zshrc"
echo "常用命令："
echo "  • 查看帮助:    skillnav --help"
echo "  • 检查身份:    skillnav whoami"
echo "  • 搜索技能:    skillnav search <关键词>"
echo "  • 发布技能:    skillnav publish"
echo "=================================================="
