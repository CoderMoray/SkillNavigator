# Dependencies
node_modules/

# Build outputs
.next/
dist/
build/
coverage/

# Generated web artifacts — scripts/sync-usage-public.mjs bakes deployment URLs
# into them at build time, so they are per-machine snapshots. Generated at
# deploy time, never committed.
/apps/web/public/install
/apps/web/public/usage/

# Auto-generated
next-env.d.ts

# Environment variables
.env
.env.local
.env.*.local

# Data & storage
.data/
installed-demo-skill/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE / local tooling
.vscode/
.idea/
.cursor/
.mcp.json
*.swp
*.swo
*~

# TypeScript
*.tsbuildinfo

# Playwright
playwright-report/
test-results/

# MinIO / Docker volumes
minio-data/
pgdata/

# Drizzle (SQL 文件需提交，meta 是本地缓存)
packages/storage/drizzle/meta/

# MailManager runtime artifacts (maildrop queue dirs are recreated at runtime;
# only .gitkeep stays tracked)
packages/MailManager/maildrop/*.pkl*
packages/MailManager/maildrop/run-*/
packages/MailManager/__pycache__/

# CodeGraph (本地索引，不提交)
.codegraph/

# Review benchmark artifacts (regenerate: npm run review:export-examples)
examples/bench-*/
examples/bench-*.zip

# Python bytecode cache (was accidentally committed before)
__pycache__/
*.pyc

